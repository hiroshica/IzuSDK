{
    // fz2 のデバッグ。gdb は SGDK に付いている m68k-elf の gdb (%SGDK%\bin\gdb.exe) を使う。
    // 元のファイルは launch.json.gcc.bak。
    "version": "0.2.0",
    "configurations": [
        {
            // F5 でビルド → run68k (SurugaCC のエミュレータ) を GDB のサーバとして起動 → 接続して main で止まる。
            // run68k は画面を出さず、パッドも押せないので、タイトル画面までの処理や初期化を追うのに向いている。
            "name": "fz2: run68k でデバッグ (SurugaCC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/rom.out",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${env:SGDK}\\bin\\gdb.exe",
            "miDebuggerServerAddress": "localhost:2345",
            "launchCompleteCommand": "exec-continue",
            "stopAtEntry": true,
            "args": [],
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "run68k: GDB サーバを起動",
            "postDebugTask": "run68k: 止める",
            "setupCommands": [
                { "text": "set directories '${workspaceFolder};$cwd;$cdir'" }
            ]
        },
        {
            // 画面を見ながら・パッドを操作しながらデバッグしたいとき。
            // 先に「SurugaCC: デバッグ用ビルド (-g)」をして、GDB のサーバを持つエミュレータで out\rom.bin を
            // デバッグ待ちで起動してから F5 (例: BlastEm は blastem.exe -D out\rom.bin で 1234 番で待つ)。
            // ポートはエミュレータに合わせて変える (2346 は元の設定のまま)。
            "name": "fz2: エミュレータにつないでデバッグ (SurugaCC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/rom.out",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${env:SGDK}\\bin\\gdb.exe",
            "miDebuggerServerAddress": "localhost:2346",
            "launchCompleteCommand": "exec-continue",
            "stopAtEntry": true,
            "args": [],
            "environment": [],
            "externalConsole": false,
            "setupCommands": [
                { "text": "set directories '${workspaceFolder};$cwd;$cdir'" }
            ]
        },
        {
            // 元の設定 (gcc の make debug で作る out\debug\rom.out 用)
            "name": "Debug with gdb remote",
            "request": "launch",
            "type": "cppdbg",
            "program": "${workspaceRoot}\\out\\debug\\rom.out",
            "miDebuggerServerAddress": "localhost:2346",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "launchCompleteCommand": "exec-continue",
            "miDebuggerPath": "${env:SGDK}\\bin\\gdb.exe",
            "setupCommands": [
                { "text": "set directories '${workspaceFolder};$cwd;$cdir'" }
            ]
        }
    ]
}
