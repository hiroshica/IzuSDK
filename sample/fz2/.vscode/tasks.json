{
    // fz2 を SurugaCC (C:\Users\hiro_\working\tools\SurugaCC) でビルド・デバッグするためのタスク。
    // surugacc-sgdk / run68k は SurugaCC の setup.bat が PATH に入れる (setup.bat <SGDK> /persist で常に入る)。
    // 元の gcc (SGDK の makefile.gen) 用のタスクは後ろに残してある。元のファイルは tasks.json.gcc.bak。
    "version": "2.0.0",
    "options": {
        "shell": {
            "executable": "${env:windir}\\system32\\cmd.exe",
            "args": [
                "/d",
                "/c"
            ]
        },
    },
    "type": "shell",

    "tasks": [
        {
            // Ctrl+Shift+B。デバッグ情報つき (-g、-O2) で out/rom.bin と out/rom.out (gdb 用の ELF) を作る
            "label": "SurugaCC: デバッグ用ビルド (-g)",
            "type": "shell",
            "command": "surugacc-sgdk",
            "args": ["-g"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            // 最適化なし。ステップ実行で行が行き来しないが、コードは遅く大きい (SGDK のライブラリも -O0 になる)
            "label": "SurugaCC: デバッグ用ビルド (-g -O 0)",
            "type": "shell",
            "command": "surugacc-sgdk",
            "args": ["-g", "-O", "0"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            // デバッグ情報なし (-O2)
            "label": "SurugaCC: リリースビルド",
            "type": "shell",
            "command": "surugacc-sgdk",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            // surugacc-sgdk はヘッダの変更を見ないので、ヘッダを変えたらこれで out を消してからビルドする
            "label": "SurugaCC: クリーン (out を消す)",
            "type": "shell",
            "command": "if exist out rmdir /s /q out",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            // launch.json の「run68k でデバッグ」が使う。ビルドしてから run68k を GDB のサーバ (localhost:2345) として起動する
            "label": "run68k: GDB サーバを起動",
            "type": "shell",
            "command": "run68k",
            "args": ["out\\rom.bin", "--gdb", "2345"],
            "dependsOn": "SurugaCC: デバッグ用ビルド (-g)",
            "isBackground": true,
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": {
                "owner": "run68k",
                "pattern": { "regexp": "^__never__(.)(.)(.)$", "file": 1, "line": 2, "message": 3 },
                "background": {
                    "activeBegins": true,
                    "beginsPattern": "^__never__$",
                    "endsPattern": "localhost:\\d+"
                }
            }
        },
        {
            // デバッグを止めたあとに残った run68k を終わらせる
            "label": "run68k: 止める",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -match 'run68k\\.py.*--gdb' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }"
            ],
            "presentation": { "reveal": "never" },
            "problemMatcher": []
        },

        // ---- ここから元の gcc (SGDK の makefile.gen) 用のタスク
{
            "label": "Task Sequence",
            "command": "echo ${env:SGDK}",
            "dependsOrder": "sequence",
            //"dependsOn": [
            //    "lib",
            //    "release"
            //],
            "problemMatcher": [],
            "group": "build",
        },
        {
            "label": "release",
            "command": "${env:SGDK}/bin/make",
            "args": [
                "-f",
                "${env:SGDK}/makefile.gen",
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
            "group": "build",
        },
        {
            "label": "debug",
            "command": "${env:SGDK}/bin/make",
            "args": [
                "-f",
                "${env:SGDK}/makefile.gen",
                "debug"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
        },
        {
            "label": "clean",
            "command": "${env:SGDK}/bin/make",
            "args": [
                "-f",
                "${env:SGDK}/makefile.gen",
                "clean-all"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
            "options": {
                "env": {
                    "SGDK": "C:/Users/hiro_/working/SGDK_work/SGDK",
                },
            },
        },
        {
            "label": "lib",
            "command": "${env:SGDK}/bin/make",
            "args": [
                "-f",
                "${env:SGDK}/makelib.gen"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
        },
        {
            "label": "libclean",
            "command": "${env:SGDK}/bin/make",
            "args": [
                "-f",
                "${env:SGDK}/makelib.gen",
                "clean"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
        },
        {
            "label": "libdebug",
            "command": "${env:SGDK}/bin/make",
            "args": [
                "-f",
                "${env:SGDK}/makelib.gen",
                "debug"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
        }
    ]
}
