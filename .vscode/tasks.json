{
    // SurugaCC でビルドする (GCC と makefile.gen / makelib.gen は使わない。surugacc/README.md を参照)
    "version": "2.0.0",
    "tasks": [
        {
            "group": "build",
            "label": "sgdk - build lib (SurugaCC)",
            "type": "shell",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/surugacc/build.ps1", "-LibOnly"],
            "problemMatcher": []
        },
        {
            "group": "build",
            "label": "sgdk - build lib debug (SurugaCC)",
            "type": "shell",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/surugacc/build.ps1", "-LibOnly", "-g"],
            "problemMatcher": []
        }
    ]
}
